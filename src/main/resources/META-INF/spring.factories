# Auto Configuration
org.springframework.boot.autoconfigure.EnableAutoConfiguration=\
cn.sunyblog.easymail.config.MailConfigCompatibilityAutoConfiguration,\
cn.sunyblog.easymail.config.EmailListenerAutoConfiguration,\
cn.sunyblog.easymail.config.EmailSenderAutoConfiguration,\
cn.sunyblog.easymail.processor.config.AnnotationDrivenEmailProcessorAutoConfiguration

# Spring Boot Configuration Properties
org.springframework.boot.context.properties.EnableConfigurationProperties=\
  cn.sunyblog.easymail.config.EmailListenerProperties,\
  cn.sunyblog.easymail.config.MailConfig,\
  cn.sunyblog.easymail.config.EmailSenderProperties,\
  cn.sunyblog.easymail.config.SmtpConfig,\
  cn.sunyblog.easymail.config.RetryConfig,\
  cn.sunyblog.easymail.processor.config.AnnotationDrivenEmailProcessorProperties