# Auto Configuration
org.springframework.boot.autoconfigure.EnableAutoConfiguration=\
cn.sunyblog.easymail.config.EasyMailConfigCompatibilityAutoConfiguration,\
cn.sunyblog.easymail.config.EasyMailListenerAutoConfiguration,\
cn.sunyblog.easymail.config.EasyMailSenderAutoConfiguration,\
cn.sunyblog.easymail.processor.config.AnnotationDrivenEasyMailProcessorAutoConfiguration

# Spring Boot Configuration Properties
org.springframework.boot.context.properties.EnableConfigurationProperties=\
  cn.sunyblog.easymail.config.EasyMailImapConfig,\
  cn.sunyblog.easymail.config.EasyMailSmtpConfig,\
  cn.sunyblog.easymail.config.EasyMailDynamicThreadPoolConfig,\
  cn.sunyblog.easymail.processor.config.AnnotationDrivenEasyMailProcessorProperties